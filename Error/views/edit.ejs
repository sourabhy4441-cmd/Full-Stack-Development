<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Your Chat</title>
</head>
<body>
    <h2> Edit Your Chats <%= chat._id %> </h2>

    <p>This chat is sent from  <b> <%= chat.from %>  </b> to <b> <%= chat.to %> </b> </p>

    <form  method="POST" action="/chats/<%= chat._id %>?_method=PUT " >
        <textarea name="message" rows="6" cols="50"> <%= chat.message %> </textarea>
        <br><br>
        <button>Edit</button>
    </form>
</body>
</html>